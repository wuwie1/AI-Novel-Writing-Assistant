{
  "name": "@ai-novel/desktop-mac",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build:native": "node native/build.mjs",
